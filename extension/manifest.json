{
  "manifest_version": 3,
  "name": "TubeNotes",
  "version": "1.0",
  "description": "My first YouTube notes extension!",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "clipboardWrite",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open TubeNotes"
    }
  }
}